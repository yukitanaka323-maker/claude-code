# SharePoint (Microsoft Graph)
SHAREPOINT_SITE_ID=your-site-id
EMPLOYEE_LIST_ID=your-employee-list-id
ORDERS_LIST_ID=your-orders-list-id
INVENTORY_LIST_ID=your-inventory-list-id
STOCK_MOVEMENTS_LIST_ID=your-stock-movements-list-id

# CORS
FRONTEND_ORIGIN=http://localhost:5173
